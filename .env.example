# Создай копию этого файла с именем .env.local.
# Не публикуй эти значения и не отправляй их в чат.

# MyAnimeList: https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# AniList: https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Shikimori: https://shikimori.one/oauth/applications
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=
SHIKIMORI_USER_AGENT=mido-anime-sync/0.5.0

# Для локального режима оставь redirect URI пустыми.
# MAL: http://127.0.0.1:3001/api/auth/mal/callback
# AniList: http://127.0.0.1:3001/api/auth/anilist/callback
# Shikimori: http://127.0.0.1:3001/api/auth/shikimori/callback
PORT=3001
HOST=127.0.0.1
