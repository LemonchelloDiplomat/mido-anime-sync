{
  "manifest_version": 3,
  "name": "mido-anime-sync Bridge",
  "version": "0.1.0",
  "description": "Передаёт подтверждённый прогресс просмотра в локальную библиотеку mido-anime-sync.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:4173/*",
    "http://localhost:4173/*"
  ],
  "action": {
    "default_title": "mido-anime-sync",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.anime-go.org/*",
        "*://*.animego.online/*",
        "*://*.animego.me/*",
        "*://*.yummyani.me/*",
        "*://*.yummy-ani.me/*",
        "*://*.anixart-app.com/*",
        "*://*.anixartapp.com/*",
        "*://aniboom.one/*",
        "https://player.cdnvideohub.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://player.cdnvideohub.com/*"
      ],
      "js": [
        "cvh-page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:3001/*",
        "http://localhost:3001/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:4173/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
